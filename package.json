{
  "name": "@antsask/portfolio",
  "version": "0.1.0",
  "repository": "git@github.com:AnTSaSk/Portfolio.git",
  "author": "Alexis Besson <me@alexisbesson.fr>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "husky",
    "lint": "pnpm -r run lint",
    "lint:styleguide": "pnpm --filter @antsask/styleguide lint",
    "lint:website": "pnpm --filter @antsask/website lint",
    "lint:style": "pnpm -r run lint:style",
    "lint:style:styleguide": "pnpm --filter @antsask/styleguide lint:style",
    "lint:style:website": "pnpm --filter @antsask/website lint:style",
    "lint:markup": "pnpm -r run lint:markup",
    "lint:markup:styleguide": "pnpm --filter @antsask/styleguide lint:markup",
    "lint:markup:website": "pnpm --filter @antsask/website lint:markup",
    "dev:styleguide": "pnpm --filter @antsask/styleguide dev",
    "dev:website": "pnpm --filter @antsask/website dev",
    "build:styleguide": "pnpm --filter @antsask/styleguide build",
    "build:website": "pnpm --filter @antsask/website build",
    "build": "pnpm -r run build",
    "generate:components": "npx tsx bin/components.ts",
    "test": "pnpm -r run test",
    "test:styleguide": "pnpm --filter @antsask/styleguide test",
    "test:website": "pnpm --filter @antsask/website test",
    "test:coverage": "pnpm -r run test:coverage",
    "perf:audit": "pnpm build:website && lhci autorun --config=lighthouserc.local.cjs && lhci autorun --config=lighthouserc.desktop.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-vue": "6.0.7",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.9.2",
    "eslint-plugin-vuejs-accessibility": "2.5.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "js-yaml": "^5.2.2",
    "knip": "6.26.0",
    "lint-staged": "17.0.8",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.5",
    "stylelint": "17.14.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.12.0"
}
