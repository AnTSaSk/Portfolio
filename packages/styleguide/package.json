{
  "name": "@antsask/styleguide",
  "version": "1.0.0",
  "repository": "git@github.com:AnTSaSk/Portfolio.git",
  "author": "Alexis Besson <me@alexisbesson.fr>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./tokens.css": "./src/assets/css/tokens.css",
    "./base.css": "./src/assets/css/base.css",
    "./utilities.css": "./src/assets/css/utilities.css",
    "./app.css": "./src/assets/css/app.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "generate:icons": "node bin/sprite.mjs",
    "lint": "npx eslint .",
    "lint:style": "stylelint src/**/*.css",
    "lint:markup": "vue-tsc --noEmit",
    "build:types": "vue-tsc --emitDeclarationOnly -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build": "pnpm lint:markup && pnpm build:types && storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-links": "10.5.0",
    "@storybook/addon-themes": "10.5.0",
    "@storybook/vue3": "10.5.0",
    "@storybook/vue3-vite": "10.5.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "2.4.11",
    "eslint-plugin-storybook": "10.5.0",
    "glob": "13.0.6",
    "jsdom": "catalog:",
    "storybook": "10.5.0",
    "svg-sprite": "2.0.4",
    "tsc-alias": "1.9.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-docgen-api": "4.79.2",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  }
}
