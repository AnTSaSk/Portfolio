# Public site URL, used for canonical/OG/sitemap absolute URLs
NUXT_BASE_URL=

# Absolute path to the @nuxt/content SQLite database (prod override; see Dockerfile)
NUXT_CONTENT_DB=

# Sentry DSN (client + server error reporting; no-op when empty)
NUXT_PUBLIC_SENTRY_DSN=

# Umami privacy-first analytics (no-op when empty). Read at BUILD time: they decide
# the script tag and the CSP origin, so prod values go through Docker build-args.
# Both SRC and WEBSITE_ID are required; DOMAINS is an optional comma-separated list.
NUXT_PUBLIC_UMAMI_SRC=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_DOMAINS=

# Sentry source-map upload at build time (CI secrets; leave empty locally to skip upload)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
