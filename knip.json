{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".lighthouserc.cjs",
        "lighthouserc.desktop.cjs",
        "lighthouserc.local.cjs"
      ],
      "ignore": ["dist/**"]
    },
    "packages/website": {
      "entry": [
        "nuxt.config.ts",
        "content.config.ts",
        "src/app.vue",
        "src/error.vue",
        "src/pages/**/*.vue",
        "src/layouts/**/*.vue",
        "src/middleware/**/*.ts",
        "src/plugins/**/*.ts",
        "src/composables/**/*.ts",
        "src/server/**/*.ts",
        "server/**/*.ts",
        "i18n.config.ts",
        "src/constants/**/*.ts",
        "src/utils/**/*.ts"
      ],
      "paths": {
        "@/*": ["src/*"],
        "~/*": ["src/*"],
        "#imports": [".nuxt/imports.d.ts"],
        "#app": [".nuxt/nuxt.d.ts"]
      },
      "ignore": [".nuxt/**", ".output/**", ".stylelintrc.mjs"],
      "ignoreDependencies": [
        "@nuxt/content",
        "@nuxtjs/i18n",
        "@nuxtjs/seo",
        "better-sqlite3",
        "jsdom",
        "eslint",
        "stylelint"
      ]
    },
    "packages/styleguide": {
      "entry": [
        "src/index.ts",
        "src/**/*.stories.ts",
        ".storybook/**/*.ts",
        "src/components/**/*.vue",
        "src/components/**/*.ts"
      ],
      "ignore": ["storybook-static/**", "types/**"]
    },
    "packages/cv": {
      "entry": ["src/main.ts", "vite.config.ts", "vitest.config.ts"],
      "ignore": ["dist/**"]
    }
  }
}
